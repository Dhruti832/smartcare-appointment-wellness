# Auth and appointments are SEPARATE API Gateways.
# Terraform outputs: auth_api_endpoint / appointments_api_endpoint
REACT_APP_AUTH_API_URL=https://auth-api-id.execute-api.us-east-1.amazonaws.com
REACT_APP_APPOINTMENTS_API_URL=https://appt-api-id.execute-api.us-east-1.amazonaws.com

# Optional single-URL fallback used when the two above are unset.
# REACT_APP_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com

# Messaging (Member 5): publishConcern Cloud Function.
# Terraform output: publish_concern_url, per-deployment, never hardcode it.
REACT_APP_PUBLISH_CONCERN_URL=https://us-central1-your-project.cloudfunctions.net/saws-publish-concern-dev

# Chatbot (Member 4): Dialogflow ES agent id for the Messenger widget.
REACT_APP_DF_AGENT_ID=

# Coordinator dashboard: Firestore communicationLogs via the REST API.
REACT_APP_GCP_PROJECT_ID=serverless-project-501905
REACT_APP_FIREBASE_API_KEY=

# Messaging reply loop: postReply Cloud Function (messaging/functions/post_reply.js).
# Terraform output once deployed: post_reply_url. Leave blank until then,
# the reply form disables itself via communicationAPI.isReplyConfigured().
REACT_APP_POST_REPLY_URL=

# Analytics (Member 7): Looker Studio report embed URL
# (Share → Embed report → use the /embed/ link).
REACT_APP_LOOKER_REPORT_URL=https://lookerstudio.google.com/embed/reporting/4484ec35-5a33-4268-a34e-12e21bd12ffa
