# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
build/
dist/
.next/
out/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# AWS credentials / config
.aws/
aws-exports.js

# GCP credentials
*credentials*.json
*service-account*.json
# Belt-and-braces: CI auth is keyless (Workload Identity Federation) and the Dal
# org policy blocks key creation anyway, but don't let a key from elsewhere slip in.
*-key.json

# Terraform state
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!terraform.tfvars.example
.terraform.lock.hcl

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Coverage
coverage/
.nyc_output/
local_backend_override.tf

# Terraform saved plan files (contain variable values)
*.tfplan
tfplan

# gcloud functions deploy auto-generates this per-directory on first deploy
.gcloudignore

# Pytest
.pytest_cache/
